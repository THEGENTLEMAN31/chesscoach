# Username par défaut analysé (compte actif vérifié)
COACH_USERNAME=thegentleman31

# LLM (facultatif — le projet fonctionne 100% sans)
OPENROUTER_KEY=
OPENROUTER_MODEL=
LLM_ENABLED=false

# ------------------------------------------------------------- auth / sécurité
# Secret de session JWT — OBLIGATOIRE en prod (via `openssl rand -hex 32`)
JWT_SECRET=change-me-en-prod
# Cookie httpOnly: secure = uniquement en HTTPS (true derrière Caddy TLS)
COOKIE_SECURE=false
# URL publique (liens de vérification email, base du cookie)
BASE_URL=https://chesscoach.btj.mooo.com
# Inscription publique fermée en prod (mono-pseudo thegentleman31)
ALLOW_REGISTRATION=false
# Mot de passe du seed admin (créé au démarrage si la base est vide du compte)
SEED_ADMIN_PASSWORD=